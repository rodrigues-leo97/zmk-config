#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        interrogation {
            bindings = <&kp QUESTION>;
            key-positions = <0 12>;
        };

        exclamation {
            bindings = <&kp LS(EXCLAMATION)>;
            key-positions = <1 13>;
        };

        arroba {
            bindings = <&kp AT_SIGN>;
            key-positions = <2 14>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <12 24>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <13 25>;
        };

        tildetwo {
            bindings = <&kp TILDE>;
            key-positions = <9 21>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC         &kp Q  &kp W  &kp E               &kp R             &kp T          &kp Y    &kp U  &kp I            &kp O    &kp P     &kp BSPC
&kp TAB         &kp A  &kp S  &kp D               &kp F             &kp G          &kp H    &kp J  &kp K            &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C               &kp V             &kp B          &kp N    &kp M  &kp COMMA        &kp DOT  &kp FSLH  &to 1
                              &lt 1 LEFT_COMMAND  &kp LEFT_CONTROL  &lt 3 SPACE    &kp RET  &mo 3  &lt 2 RIGHT_ALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB            &kp N1        &kp N2  &kp N3    &kp N4  &kp N5       &kp N6    &kp UP_ARROW  &kp N8     &kp N9     &kp N0  &kp BSPC
&kp LEFT_BRACKET   &kp NUMBER_6  &kp N7  &kp N8    &kp N9  &kp N0       &kp LEFT  &kp DOWN      &kp RIGHT  &kp RIGHT  &trans  &trans
&kp RIGHT_BRACKET  &trans        &trans  &trans    &trans  &trans       &trans    &trans        &trans     &trans     &trans  &to 0
                                         &kp LGUI  &trans  &kp SPACE    &kp RET   &trans        &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL   &kp AT      &kp HASH  &kp DLLR  &kp PRCNT         &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &kp EQUAL  &kp DELETE  &trans    &trans    &trans            &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans     &trans      &trans    &trans    &bt BT_CLR_ALL    &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                  &kp LGUI  &trans    &kp SPACE         &kp RET    &trans     &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&kp EXCLAMATION  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL  &trans  &kp BACKSPACE    &trans  &trans  &trans         &trans            &trans        &trans
&kp TILDE        &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans     &trans  &trans           &trans  &trans  &trans         &trans            &kp COLON     &kp DOUBLE_QUOTES
&kp UNDERSCORE   &trans                &trans                 &trans     &trans  &trans           &trans  &trans  &kp LESS_THAN  &kp GREATER_THAN  &kp QUESTION  &trans
                                                              &trans     &trans  &trans           &trans  &trans  &kp SLASH
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        qa {
            if-layers = <1>;
            then-layer = <1>;
        };

        ws {
            if-layers = <2>;
            then-layer = <2>;
        };
    };
};
